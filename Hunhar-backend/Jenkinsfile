// =====================================================================
// THEUNOiA backend - CI/CD pipeline (Declarative)
//   build -> unit+integration tests -> quality gate -> images (parallel) -> scan
//   -> deploy staging -> smoke test -> manual approval -> deploy production
//
// Two modes:
//   * LOCAL   (DOCKER_REGISTRY empty): images are built into the host Docker engine (Docker Desktop) and
//             used directly by its Kubernetes - this is what scripts/setup-jenkins.ps1 configures.
//   * REGISTRY (DOCKER_REGISTRY=registry.example.com/theunoia): images are pushed, any cluster can pull them.
//
// Credentials: kubeconfig-staging, theunoia-secrets-staging (file), docker-registry (user/pass, registry mode),
//              kubeconfig-production, theunoia-secrets-production (only for production deploys)
// =====================================================================

def SERVICES = ['api-gateway', 'auth-service', 'user-service', 'project-service', 'credit-service', 'payment-service',
                'messaging-service', 'notification-service', 'community-service', 'content-service',
                'analytics-service', 'file-service']

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '30'))
        timeout(time: 120, unit: 'MINUTES')
    }

    parameters {
        booleanParam(name: 'BUILD_ALL', defaultValue: false, description: 'Rebuild every service image (ignore change detection)')
        booleanParam(name: 'SKIP_TESTS', defaultValue: false, description: 'Emergency hotfix only - skip the test stage')
        booleanParam(name: 'DEPLOY_STAGING', defaultValue: true, description: 'Deploy to the staging cluster')
        booleanParam(name: 'DEPLOY_PRODUCTION', defaultValue: false, description: 'Promote to production after staging (main only)')
    }

    environment {
        REGISTRY        = "${env.DOCKER_REGISTRY ?: ''}"
        MAVEN_OPTS      = '-Xmx768m'
        IMAGE_TAG       = "${env.BUILD_NUMBER}"   // finalised as <build>-<git sha> in Checkout
        DOCKER_BUILDKIT = '1'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                script {
                    env.GIT_SHORT = sh(script: 'git rev-parse --short=8 HEAD', returnStdout: true).trim()
                    env.IMAGE_TAG = "${env.BUILD_NUMBER}-${env.GIT_SHORT}"
                    env.BRANCH = env.BRANCH_NAME ?: (env.GIT_BRANCH ?: 'main').replaceFirst('^origin/', '')
                    currentBuild.displayName = "#${env.BUILD_NUMBER} ${env.BRANCH} ${env.GIT_SHORT}"
                    echo "Mode: ${env.REGISTRY ? 'REGISTRY ' + env.REGISTRY : 'LOCAL (host Docker engine)'}"
                }
            }
        }

        stage('Detect changed services') {
            steps {
                script {
                    def base = sh(script: 'git rev-parse HEAD~1 2>/dev/null || echo ""', returnStdout: true).trim()
                    def diff = base ? (sh(script: "git diff --name-only ${base} HEAD", returnStdout: true).trim().split('\n') as List) : []
                    boolean shared = params.BUILD_ALL == true || !base ||
                            diff.any { it.startsWith('common-lib/') || it == 'pom.xml' || it == 'Dockerfile' }
                    def changed = shared ? SERVICES : SERVICES.findAll { svc -> diff.any { it.startsWith("${svc}/") } }
                    env.CHANGED_SERVICES = changed.join(',')
                    echo "Services to build: ${env.CHANGED_SERVICES ?: '(none)'}"
                }
            }
        }

        stage('Build & Test') {
            when { expression { params.SKIP_TESTS != true } }
            steps {
                // Integration tests use embedded PostgreSQL - no external database needed on the agent.
                sh 'mvn -B -ntp clean verify'
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: '**/target/surefire-reports/*.xml'
                }
            }
        }

        stage('Package (tests skipped)') {
            when { expression { params.SKIP_TESTS == true } }
            steps {
                sh 'mvn -B -ntp clean package -DskipTests'
            }
        }

        stage('Code quality') {
            when { expression { return env.SONAR_HOST_URL } }
            steps {
                withSonarQubeEnv('sonarqube') {
                    sh 'mvn -B -ntp sonar:sonar -Dsonar.projectKey=theunoia-backend'
                }
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build images') {
            when { expression { env.CHANGED_SERVICES } }
            steps {
                script {
                    if (env.REGISTRY) {
                        withCredentials([usernamePassword(credentialsId: 'docker-registry', usernameVariable: 'REG_USER', passwordVariable: 'REG_PASS')]) {
                            sh 'echo "$REG_PASS" | docker login "${REGISTRY%%/*}" -u "$REG_USER" --password-stdin'
                        }
                    }
                    def builds = [:]
                    env.CHANGED_SERVICES.split(',').each { svc ->
                        builds[svc] = {
                            if (env.REGISTRY) {
                                sh """
                                  docker buildx build --build-arg SERVICE=${svc} \\
                                    --cache-from type=registry,ref=${REGISTRY}/${svc}:buildcache \\
                                    --cache-to type=registry,ref=${REGISTRY}/${svc}:buildcache,mode=max \\
                                    --label org.opencontainers.image.revision=${env.GIT_SHORT} \\
                                    -t ${REGISTRY}/${svc}:${IMAGE_TAG} --push .
                                """
                            } else {
                                sh "docker build -q --build-arg SERVICE=${svc} --label org.opencontainers.image.revision=${env.GIT_SHORT} -t theunoia/${svc}:${IMAGE_TAG} ."
                            }
                        }
                    }
                    // local engines with little RAM: build 3 images at a time
                    def keys = builds.keySet() as List
                    keys.collate(env.REGISTRY ? 12 : 3).each { group -> parallel builds.subMap(group) }
                }
            }
        }

        stage('Image security scan') {
            when { expression { env.CHANGED_SERVICES && sh(script: 'command -v trivy', returnStatus: true) == 0 } }
            steps {
                script {
                    env.CHANGED_SERVICES.split(',').each { svc ->
                        sh "trivy image --exit-code 1 --severity CRITICAL --ignore-unfixed ${imageRepo(svc)}:${IMAGE_TAG}"
                    }
                }
            }
        }

        stage('Deploy to staging') {
            when { expression { params.DEPLOY_STAGING != false && env.BRANCH in ['main', 'develop'] } }
            steps {
                script { deploy('staging', 'theunoia-staging', SERVICES) }
            }
        }

        stage('Smoke test staging') {
            when { expression { params.DEPLOY_STAGING != false && env.BRANCH in ['main', 'develop'] } }
            steps {
                withCredentials([file(credentialsId: 'kubeconfig-staging', variable: 'KUBECONFIG')]) {
                    // runs inside the cluster, so it works with or without an ingress controller
                    sh '''
                      kubectl -n theunoia-staging delete pod smoke-test --ignore-not-found
                      kubectl -n theunoia-staging run smoke-test --rm -i --restart=Never --image=curlimages/curl:8.10.1 \
                        --labels=app.kubernetes.io/part-of=theunoia -- sh -c '
                          set -e
                          curl -fsS http://api-gateway:8080/actuator/health
                          curl -fsS -o /dev/null http://api-gateway:8080/api/v1/categories
                          curl -fsS -o /dev/null http://api-gateway:8080/api/v1/content/pages/home
                          echo SMOKE-OK'
                    '''
                }
            }
        }

        stage('Approve production') {
            when { expression { params.DEPLOY_PRODUCTION == true && env.BRANCH == 'main' } }
            steps {
                timeout(time: 2, unit: 'HOURS') {
                    input message: "Deploy ${env.IMAGE_TAG} to PRODUCTION?", ok: 'Deploy'
                }
            }
        }

        stage('Deploy to production') {
            when { expression { params.DEPLOY_PRODUCTION == true && env.BRANCH == 'main' } }
            steps {
                script { deploy('production', 'theunoia', SERVICES) }
            }
        }
    }

    post {
        success {
            echo "Pipeline succeeded - images tagged ${env.IMAGE_TAG}"
        }
        failure {
            echo 'Pipeline failed - see the stage logs. Failed Kubernetes rollouts are undone automatically.'
        }
        always {
            script { if (env.REGISTRY) { sh 'docker logout "${REGISTRY%%/*}" || true' } }
            cleanWs(deleteDirs: true, notFailBuild: true)
        }
    }
}

def imageRepo(String svc) {
    return env.REGISTRY ? "${env.REGISTRY}/${svc}" : "theunoia/${svc}"
}

/**
 * Renders a kustomization on top of the overlay with immutable image tags, (re)creates the application
 * Secret from the Jenkins credential store, runs the idempotent DB provisioning Job and waits for every
 * rollout. Services not rebuilt in this run keep the image currently running. A failed rollout is undone.
 */
def deploy(String overlay, String namespace, List services) {
    withCredentials([
            file(credentialsId: "kubeconfig-${overlay}", variable: 'KUBECONFIG'),
            file(credentialsId: "theunoia-secrets-${overlay}", variable: 'SECRETS_ENV')]) {
        sh """
          kubectl get namespace ${namespace} >/dev/null 2>&1 || kubectl create namespace ${namespace}
          kubectl -n ${namespace} create secret generic theunoia-secrets --from-env-file="\$SECRETS_ENV" \\
            --dry-run=client -o yaml | kubectl apply -f -
        """
        def built = (env.CHANGED_SERVICES ?: '').split(',').findAll { it }
        def images = services.collect { svc ->
            def current = sh(script: "kubectl -n ${namespace} get deploy ${svc} -o jsonpath='{.spec.template.spec.containers[0].image}' 2>/dev/null || true",
                    returnStdout: true).trim()
            def tag = (built.contains(svc) || !current || current.endsWith(':latest')) ? env.IMAGE_TAG : current.substring(current.lastIndexOf(':') + 1)
            "  - name: theunoia/${svc}\n    newName: ${imageRepo(svc)}\n    newTag: \"${tag}\""
        }.join('\n')
        writeFile file: ".deploy/${overlay}/kustomization.yaml", text: """apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
  - ../../k8s/overlays/${overlay}
images:
${images}
"""
        sh """
          kubectl -n ${namespace} delete job db-provisioner --ignore-not-found
          kubectl apply -k .deploy/${overlay}
          kubectl -n ${namespace} wait --for=condition=complete job/db-provisioner --timeout=900s
        """
        services.each { svc ->
            def status = sh(script: "kubectl -n ${namespace} rollout status deploy/${svc} --timeout=900s", returnStatus: true)
            if (status != 0) {
                sh "kubectl -n ${namespace} rollout undo deploy/${svc}"
                error("Rollout of ${svc} failed in ${overlay}; rolled back")
            }
        }
    }
}
