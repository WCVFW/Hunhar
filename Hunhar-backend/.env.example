# ------------------------------------------------------------------
# THEUNOiA backend - environment template (copy to .env for docker compose)
# NEVER commit real secrets. In Kubernetes these live in Secrets.
# ------------------------------------------------------------------

# Security (generate: openssl rand -base64 48 / openssl rand -base64 32)
JWT_SECRET=ZGV2LW9ubHktand0LXNlY3JldC1jaGFuZ2UtbWUtaW4tcHJvZHVjdGlvbi0zMmJ5dGVzIQ==
INTERNAL_SERVICE_TOKEN=dev-internal-token-change-me
PAYMENT_ENCRYPTION_KEY=ZGV2LW9ubHktMzItYnl0ZS1hZXMta2V5LWNoYW5nZSE=
NOTIFICATION_ENCRYPTION_KEY=ZGV2LW9ubHktMzItYnl0ZS1hZXMta2V5LWNoYW5nZSE=

# Bootstrap admin
ADMIN_EMAIL=admin@theunoia.com
ADMIN_PASSWORD=Admin@12345

# Infrastructure
POSTGRES_PASSWORD=postgres
RABBITMQ_USER=theunoia
RABBITMQ_PASSWORD=theunoia
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# URLs
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Payments: mock | razorpay | cashfree      Payouts: mock | razorpayx
PAYMENT_PROVIDER=mock
PAYOUT_PROVIDER=mock
PLATFORM_COMMISSION_RATE=0.10
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAYX_ACCOUNT_NUMBER=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=

# KYC (Aadhaar via DigiLocker): mock | cashfree
KYC_PROVIDER=mock

# WhatsApp Business (Meta Cloud API)
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (MailHog locally; SES/SendGrid SMTP in production)
SMTP_HOST=mailhog
SMTP_PORT=1025
