# =============================================================================
# Hunhar backend configuration - ONE file for all 5 services.
#
#   Local:      copy to Hunhar-backend/.env and fill in. Every service reads it on startup.
#   Jenkins:    upload the filled file as the Secret file credential `hunhar-backend-env`.
#   Production: same keys as real environment variables (they override .env).
#
# Never commit the real .env. Restart the services after changing it.
# How to get each key: docs/CREDENTIALS.md
# Do NOT add PORT or DB_NAME here: every service would pick them up and collide.
# =============================================================================

# ---- Database (MySQL 8) - each service creates its own database automatically ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me

# ---- Security (identical for every service) ----
# Signs login tokens. At least 32 random characters. Changing it logs everyone out.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-characters
# Shared key for service-to-service /internal/** calls
INTERNAL_API_KEY=change-me-internal-key

# ---- Email OTP: signup and password reset codes (SMTP, STARTTLS on 587) ----
# Resend: host smtp.resend.com, username "resend", password = your Resend API key (re_...),
#         MAIL_FROM must be an address on a domain verified in Resend.
# Gmail:  host smtp.gmail.com, username = your address, password = a 16-char App Password.
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Sender address (required for Resend; defaults to MAIL_USERNAME otherwise)
MAIL_FROM=howdy@yourdomain.com
MAIL_FROM_NAME=Hunhar

# ---- Continue with Google ----
# OAuth 2.0 "Web application" client id from Google Cloud Console. Empty = Google button disabled.
GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com

# ---- Payments (Razorpay) ----
# Test keys start with rzp_test_, live keys with rzp_live_ (Dashboard > Account & Settings > API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Secret you type when creating the webhook (Dashboard > Webhooks)
RAZORPAY_WEBHOOK_SECRET=change-me-webhook-secret
# true = simulated checkout when no Razorpay keys are set (local only). MUST be false in production.
PAYMENTS_ALLOW_MOCK=true

# ---- Platform admin (created on first identity-service start) ----
ADMIN_EMAIL=admin@hunhar.in
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=Hunhar Admin

# ---- Allowed browser origins (gateway CORS + chat WebSocket) ----
# Comma separated; * = any subdomain, :[*] = any port. Unset = https://hunhar.in, https://www.hunhar.in, every
# https://<sub>.hunhar.in, and localhost / 127.0.0.1 on any port. Only set it to add other sites (e.g. a Vercel preview URL).
# CORS_ALLOWED_ORIGINS=https://hunhar.in:[*],https://*.hunhar.in:[*],http://localhost:[*],https://localhost:[*],http://127.0.0.1:[*]

# ---- API payload encryption (gateway) ----
# true = the browser must use the encrypted channel for every API call (the web app always does)
API_ENCRYPTION_REQUIRED=true
# Optional. Empty = the gateway creates Hunhar-backend/.api-enc-key on first start.
# With several gateway servers, copy that file's contents here so they share one key.
API_ENC_KEY_PAIR=

# ---- File uploads ----
# local = this server's disk (UPLOADS_DIR); s3 = Amazon S3
STORAGE_TYPE=local
UPLOADS_DIR=./uploads
S3_BUCKET=hunhar-uploads
S3_REGION=ap-south-1
# IAM user key with s3:ListBucket, GetObject, PutObject, DeleteObject on the bucket.
# Leave empty on an AWS server that has an IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- WhatsApp alerts (Meta WhatsApp Cloud API) - optional ----
# Business Manager > WhatsApp > API Setup. Empty = WhatsApp alerts are skipped (logged only).
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=en

# ---- SMS OTP: mobile number verification at signup ----
# MOBILE_OTP_PROVIDER: sms = the server sends the code (APITXT / Fast2SMS); firebase = Firebase phone sign-in
MOBILE_OTP_PROVIDER=sms
# SMS_PROVIDER: apitxt | fast2sms | auto (APITXT when APITXT_API_KEY is set)
SMS_PROVIDER=auto
APITXT_API_KEY=
# Optional SMS template id from the APITXT dashboard (blank = APITXT default OTP template)
APITXT_TEMPLATE_ID=
FAST2SMS_API_URL=https://www.fast2sms.com/dev/bulkV2
FAST2SMS_API_KEY=
# true = signup must verify the mobile by SMS code. Empty API key = codes are printed in the identity log (dev).
MOBILE_OTP_REQUIRED=true
# Max SMS codes per number per day (protects your SMS balance)
MOBILE_OTP_DAILY_LIMIT=5
