// =============================================================================
// Hunhar LIVE deploy: every push to GitHub main -> test -> deploy ONLY what changed -> smoke test -> live
//
//   GitHub push (webhook, or the 2-minute poll as fallback)
//     -> Checkout
//     -> Detect changes since the last successful deploy (deploy/ec2/detect-changes.sh):
//          website change  -> website only (no backend restart, no downtime)
//          service change  -> only that service (common-lib / parent pom -> all 5)
//          docs only       -> nothing
//     -> Test: backend compile + unit tests (mvn verify) / website type-check + lint — a failure stops here
//     -> Build release with only those parts
//     -> [Approve "Deploy to live?" only when REQUIRE_APPROVAL is ticked]
//     -> Deploy on the server: DB backup, services replaced one at a time, website swapped in one step
//     -> Smoke test on the server (encrypted API flow like a browser) — a failure ROLLS BACK automatically
//     -> hunhar-doctor + the same smoke test through https://www.hunhar.in
//
// Jenkins job: Pipeline script from SCM, Script Path = deploy/ec2/Jenkinsfile
// Credentials: hunhar-ec2-ssh (SSH Username with private key), hunhar-ec2-host (Secret text: Elastic IP)
// Setup and usage: deploy/ec2/JENKINS.md
// The root Jenkinsfile is separate: it builds and runs everything on the Jenkins machine (test only).
// =============================================================================

pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '3'))
        timeout(time: 90, unit: 'MINUTES')
    }

    triggers {
        // Instant: GitHub webhook -> https://jenkins.hunhar.in/github-webhook/ (needs the GitHub plugin)
        githubPush()
        // Fallback when the webhook cannot reach Jenkins (e.g. Jenkins on a home PC): look for new commits every 2 minutes
        pollSCM('H/2 * * * *')
    }

    parameters {
        choice(name: 'DEPLOY_SCOPE', choices: ['auto', 'website', 'backend', 'everything'], description: 'auto = only what changed since the last successful deploy; or force website / all backend services / everything')
        booleanParam(name: 'REQUIRE_APPROVAL', defaultValue: false, description: 'Pause and ask "Deploy to live?" before deploying (off = every push to main goes live automatically)')
        booleanParam(name: 'CHECK_PUBLIC_URLS', defaultValue: true, description: 'After deploying, also run the smoke test through https://www.hunhar.in (a warning only)')
        string(name: 'GIT_BASH', defaultValue: 'C:\\Program Files\\Git\\bin\\bash.exe', description: 'Windows Jenkins only: Git Bash used to run the build and deploy scripts')
    }

    environment {
        MAVEN_OPTS = '-Xmx1024m'
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    def scmVars = checkout scm
                    env.LAST_DEPLOYED = scmVars.GIT_PREVIOUS_SUCCESSFUL_COMMIT ?: ''
                    def commit = env.GIT_COMMIT ? env.GIT_COMMIT.substring(0, 7) : 'local'
                    env.RELEASE_NAME = "hunhar-release-b${env.BUILD_NUMBER}-${commit}"
                    currentBuild.description = "${env.RELEASE_NAME}"
                }
                echo "Live build #${env.BUILD_NUMBER} of commit ${env.GIT_COMMIT ?: 'local'} on ${isUnix() ? 'Linux' : 'Windows'}"
            }
        }

        stage('Detect changes') {
            steps {
                script {
                    def out = bashOut("bash deploy/ec2/detect-changes.sh '${env.LAST_DEPLOYED}' '${env.GIT_COMMIT ?: 'HEAD'}' '${params.DEPLOY_SCOPE ?: 'auto'}'")
                    def kv = [:]
                    out.split('\n').each { line -> def i = line.indexOf('='); if (i > 0) kv[line.substring(0, i).trim()] = line.substring(i + 1).trim() }
                    env.DEPLOY_SERVICES = kv.SERVICES ?: ''
                    env.DEPLOY_WEBSITE = kv.WEBSITE ?: '0'
                    env.DEPLOY_SCRIPTS = kv.SCRIPTS ?: '0'
                    env.DEPLOY_SOMETHING = (env.DEPLOY_SERVICES || env.DEPLOY_WEBSITE == '1' || env.DEPLOY_SCRIPTS == '1') ? '1' : '0'
                    currentBuild.description = "${env.RELEASE_NAME}: ${kv.SUMMARY ?: ''}"
                    echo "Deploy plan: ${kv.SUMMARY}"
                }
            }
        }

        stage('Test backend') {
            when { expression { env.DEPLOY_SERVICES } }
            steps {
                // Compiles the changed services (and common-lib) and runs their unit tests; any failure stops the deploy
                bashRun("cd Hunhar-backend && mvn -B -q verify -pl ${env.DEPLOY_SERVICES.trim().replace(' ', ',')} -am")
            }
            post {
                always { junit allowEmptyResults: true, testResults: 'Hunhar-backend/**/target/surefire-reports/*.xml' }
            }
        }

        stage('Test website') {
            when { expression { env.DEPLOY_WEBSITE == '1' } }
            steps {
                // TypeScript type-check + lint errors (warnings are reported, not fatal)
                bashRun('cd Hunhar-frontend && npm ci --no-audit --no-fund --loglevel=error && npx tsc -b && npx oxlint')
            }
        }

        stage('Build release') {
            when { expression { env.DEPLOY_SOMETHING == '1' } }
            steps {
                // Only the changed services and/or the website + server scripts -> one file
                withEnv(["SERVICES=${env.DEPLOY_SERVICES ?: 'none'}", "WEBSITE=${env.DEPLOY_WEBSITE}"]) {
                    bashRun('bash deploy/ec2/build-release.sh')
                }
                archiveArtifacts artifacts: "release/${env.RELEASE_NAME}.tar.gz*", fingerprint: true
            }
        }

        stage('Approve') {
            when { expression { params.REQUIRE_APPROVAL && env.DEPLOY_SOMETHING == '1' } }
            steps {
                timeout(time: 2, unit: 'HOURS') {
                    input message: "Deploy ${env.RELEASE_NAME} to LIVE (www.hunhar.in)?", ok: 'Deploy to live'
                }
            }
        }

        stage('Deploy to EC2') {
            // Only main goes live; any other branch is built and archived but never deployed
            when { expression { def b = env.GIT_BRANCH ?: 'main'; (b == 'main' || b.endsWith('/main')) && env.DEPLOY_SOMETHING == '1' } }
            steps {
                withCredentials([
                    sshUserPrivateKey(credentialsId: 'hunhar-ec2-ssh', keyFileVariable: 'SSH_KEY', usernameVariable: 'SSH_USER'),
                    string(credentialsId: 'hunhar-ec2-host', variable: 'EC2_HOST')
                ]) {
                    withEnv([
                        "RELEASE_FILE=release/${env.RELEASE_NAME}.tar.gz",
                        "CHECK_PUBLIC=${params.CHECK_PUBLIC_URLS ? '1' : '0'}"
                    ]) {
                        bashRun('bash deploy/ec2/jenkins-deploy.sh')
                    }
                }
            }
        }
    }

    post {
        success {
            echo """
==========================================================
 ${currentBuild.description}
   Website : https://www.hunhar.in
 Undo this deploy (on the server):  sudo hunhar-deploy --rollback
=========================================================="""
        }
        failure {
            echo '''
Live deploy FAILED. Tests or the build failed (nothing changed on the server), or the deploy / smoke test
failed and was rolled back automatically. On the server: sudo hunhar-doctor
and journalctl -u hunhar@<service> -n 100 --no-pager'''
        }
        always {
            // Release files are archived in Jenkins; no need to keep them in the workspace
            script {
                if (isUnix()) {
                    sh 'rm -f release/*.tar.gz release/*.sha256 || true'
                } else {
                    bat 'del /q release\\*.tar.gz release\\*.sha256 2>nul & exit /b 0'
                }
            }
        }
    }
}

/** Runs a bash command and returns its output. */
def bashOut(String cmd) {
    if (isUnix()) {
        return sh(returnStdout: true, script: cmd).trim()
    }
    return bat(returnStdout: true, script: "@\"${params.GIT_BASH}\" -c \"${cmd}\"").trim()
}

/** Runs a bash command on Linux agents, or through Git Bash on Windows agents. */
def bashRun(String cmd) {
    if (isUnix()) {
        sh cmd
    } else {
        bat "\"${params.GIT_BASH}\" -c \"${cmd}\""
    }
}
