{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListBackups",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::YOUR-BACKUP-BUCKET",
      "Condition": { "StringLike": { "s3:prefix": ["mysql-backups/*"] } }
    },
    {
      "Sid": "ReadWriteDeleteBackups",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::YOUR-BACKUP-BUCKET/mysql-backups/*"
    }
  ]
}
